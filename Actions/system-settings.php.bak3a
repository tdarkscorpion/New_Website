                <span class="badge badge-gold" style="background: #00d2d3; color: #000;">Exchange Engine</span>
            </div>

            <div class="input-grid">
                <!-- Master Enable/Disable Toggle -->
                <div class="form-group full-width">
                    <div class="toggle-card checkbox-item" style="border-color: rgba(0, 210, 211, 0.3); background: rgba(0, 210, 211, 0.03);">
                        <label class="checkbox-label" style="justify-content: space-between;">
                            <div style="display: flex; align-items: center; gap: 12px;">
                                <i class="fas fa-power-off" style="color: #00d2d3; font-size: 1.3rem;"></i>
                                <div>
                                    <span style="display: block; font-weight: 800; color: #00d2d3;">Enable GP Currency Conversion</span>
                                    <small style="color: #888; font-weight: 400;">Allows logged-in players to exchange their Gift Points (GP) into in-game <?php echo htmlspecialchars($tp_name); ?> (GD) directly from their dashboard.</small>
                                </div>
                            </div>
                            <input type="checkbox" name="options[gp_convert_enabled]" value="1" <?php echo (GetWebsiteOption('gp_convert_enabled') !== '0' ? 'checked' : ''); ?> style="width: 22px; height: 22px;">
                        </label>
                    </div>
                </div>

                <!-- GP to Currency (GD) Ratio -->
                <div class="form-group full-width">
                    <label style="color: #00d2d3;"><i class="fas fa-gem"></i> Conversion Rate: GP Required per 1 <?php echo htmlspecialchars($tp_name); ?> / Gold (GD)</label>
                    <div class="input-wrapper">
                        <input type="number" step="0.1" min="0.1" name="options[gp_convert_ratio_tp]" value="<?php echo htmlspecialchars(GetWebsiteOption('gp_convert_ratio_tp') ?: '10'); ?>" class="input-modern" placeholder="e.g. 10">
                    </div>
                    <small style="color: #888;">Example: Setting to 10 means 10 GP converts into 1 GD (e.g. 1,000 GP = 100 <?php echo htmlspecialchars($tp_short); ?> credited to game account).</small>
                </div>

                <!-- Minimum GP per Transaction -->
                <div class="form-group">
                    <label style="color: #fcc419;"><i class="fas fa-sliders-h"></i> Minimum GP per Transaction</label>
                    <div class="input-wrapper">
                        <input type="number" step="1" min="1" name="options[gp_convert_min_gp]" value="<?php echo htmlspecialchars(GetWebsiteOption('gp_convert_min_gp') ?: '100'); ?>" class="input-modern" placeholder="e.g. 100">
                    </div>
                    <small style="color: #888;">Minimum amount of GP a player must convert in a single transaction.</small>
                </div>

                <!-- Daily Max GP per Account -->
                <div class="form-group">
                    <label style="color: #f87171;"><i class="fas fa-calendar-day"></i> Daily Max GP Conversion per Account</label>
                    <div class="input-wrapper">
                        <input type="number" step="1" min="0" name="options[gp_convert_max_per_day]" value="<?php echo htmlspecialchars(GetWebsiteOption('gp_convert_max_per_day') ?: '0'); ?>" class="input-modern" placeholder="0 = Unlimited">
                    </div>
                    <small style="color: #888;">Enter 0 for unlimited daily conversions per account.</small>
                </div>
            </div>
        </div>

        <!-- FORM ACTION BUTTONS -->
        <div style="display: flex; gap: 15px; justify-content: flex-end; align-items: center; flex-wrap: wrap; padding: 20px 0 40px; border-top: 1px solid rgba(255,255,255,0.07); margin-top: 5px;">
            <a href="Actions/system-update.php?method=db_sync&redirect=1"
               onclick="return confirm('Apply missing database tables and column updates now?');"
               class="btn btn-large"
               style="background: linear-gradient(135deg, #3b82f6, #1d4ed8); color: #fff; text-decoration: none; display: inline-flex; align-items: center; gap: 10px; border-radius: 30px; padding: 14px 35px; font-size: 1rem; font-weight: 700;">
                <i class="fas fa-database"></i> Apply Database Updates
            </a>
            <button type="submit" class="btn btn-gold btn-large">
                <i class="fas fa-save"></i> Synchronize All Settings
            </button>
        </div>

    </form>
</div>

<style>
:root {
    --gold: #fcc419;
    --gold-dim: rgba(252, 196, 25, 0.1);
    --glass-bg: rgba(255, 255, 255, 0.03);
    --glass-border: rgba(255, 255, 255, 0.08);
}

.settings-container { max-width: 1100px; margin: 0 auto; padding: 20px; color: #fff; }

.settings-header { display: flex; align-items: center; gap: 20px; margin-bottom: 35px; }
.header-icon { width: 60px; height: 60px; background: var(--gold-dim); border: 1px solid var(--gold); border-radius: 15px; display: flex; align-items: center; justify-content: center; font-size: 1.8rem; color: var(--gold); box-shadow: 0 0 20px rgba(252, 196, 25, 0.2); }
.settings-header h2 { margin: 0; font-size: 1.8rem; font-weight: 700; background: linear-gradient(to bottom, #fff, #ccc); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
.subtitle { margin: 5px 0 0; color: #888; font-size: 0.95rem; }

.glass-card { background: var(--glass-bg); border: 1px solid var(--glass-border); border-radius: 20px; padding: 30px; backdrop-filter: blur(10px); margin-bottom: 25px; transition: 0.3s ease; }
.glass-card:hover { border-color: rgba(252, 196, 25, 0.2); }

.section-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px; }
.section-header h3 { margin: 0; font-size: 1.2rem; color: var(--gold); display: flex; align-items: center; gap: 10px; }
.badge-gold { background: var(--gold); color: #000; padding: 4px 10px; border-radius: 6px; font-size: 0.75rem; font-weight: 800; text-transform: uppercase; }

.toggle-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 15px; }
.toggle-card { background: rgba(0,0,0,0.2); padding: 15px; border-radius: 12px; border: 1px solid var(--glass-border); display: flex; flex-direction: column; gap: 10px; }
.toggle-card label { font-size: 0.8rem; color: #888; font-weight: 600; }

.checkbox-item { cursor: pointer; transition: 0.2s; }
.checkbox-item:hover { background: rgba(252, 196, 25, 0.05); border-color: var(--gold-dim); }
.checkbox-label { display: flex !important; align-items: center; gap: 12px; margin: 0 !important; cursor: pointer; width: 100%; color: #fff !important; }
.checkbox-label input { width: 18px; height: 18px; accent-color: var(--gold); }
.checkbox-label i { color: var(--gold); font-size: 1.1rem; width: 20px; text-align: center; }

.input-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
.form-group { display: flex; flex-direction: column; gap: 8px; }
.form-group.full-width { grid-column: span 2; }
.form-group label { font-size: 0.85rem; color: #888; font-weight: 600; padding-left: 5px; }

.input-modern { width: 100%; background: rgba(0,0,0,0.3); border: 1px solid var(--glass-border); color: #fff; padding: 12px 15px; border-radius: 12px; font-size: 0.95rem; transition: 0.3s; box-sizing: border-box; }
.input-modern:focus { border-color: var(--gold); background: rgba(0,0,0,0.5); box-shadow: 0 0 15px rgba(252, 196, 25, 0.1); outline: none; }
.input-color { height: 45px; padding: 5px; cursor: pointer; }

.select-modern { width: 100%; background: #111; border: 1px solid var(--glass-border); color: #fff; padding: 10px; border-radius: 8px; cursor: pointer; }

.download-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
.download-source-card { background: rgba(0,0,0,0.2); padding: 20px; border-radius: 15px; border: 1px solid var(--glass-border); }
.source-header { font-weight: 800; color: var(--gold); margin-bottom: 15px; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 1px; }

.form-actions { text-align: right; margin-top: 20px; margin-bottom: 40px; }
.btn { border: none; border-radius: 30px; padding: 12px 35px; font-weight: 700; cursor: pointer; transition: 0.3s; display: inline-flex; align-items: center; gap: 10px; }
.btn-gold { background: linear-gradient(135deg, var(--gold), #da9d06); color: #000; box-shadow: 0 4px 15px rgba(252, 196, 25, 0.3); }
.btn-gold:hover { transform: translateY(-2px); box-shadow: 0 8px 25px rgba(252, 196, 25, 0.5); }
.btn-large { font-size: 1.1rem; padding: 15px 50px; }

.alert { padding: 15px 20px; border-radius: 12px; margin-bottom: 25px; display: flex; align-items: center; gap: 12px; font-weight: 600; }
.alert-success { background: rgba(74, 222, 128, 0.1); border: 1px solid #4ade80; color: #4ade80; }
.alert-error { background: rgba(248, 113, 113, 0.1); border: 1px solid #f87171; color: #f87171; }

@media (max-width: 900px) {
    .download-grid { grid-template-columns: 1fr; }
    .input-grid { grid-template-columns: 1fr; }
    .form-group.full-width { grid-column: auto; }
}
</style>
