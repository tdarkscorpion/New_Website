<?php
if (session_status() === PHP_SESSION_NONE) { session_start(); }
require_once __DIR__ . '/../include/config.php';

if (isset($_GET['method']) && $_GET['method'] === 'update_visibility') {
    header('Content-Type: application/json');
    if (!IsAdministrator()) {
        echo json_encode(['status' => 'error', 'message' => 'Access Denied: Administrator level required']);
        exit;
    }
    try {
        $failed = [];
        foreach ($_POST as $name => $val) {
            $saved = SetWebsiteOption($name, $val);
            if ($saved === false) {
                $failed[] = $name;
            }
        }
        if (count($failed) > 0) {
            echo json_encode(['status' => 'error', 'message' => 'Failed to save settings in database: ' . implode(', ', $failed)]);
        } else {
            echo json_encode(['status' => 'success', 'message' => 'Visibility updated']);
        }
    } catch (Exception $e) {
        echo json_encode(['status' => 'error', 'message' => $e->getMessage()]);
    }
    exit;
}

if (!IsAdministrator()) {
    die("Access Denied");
}
$db_misc = Connection('db_misc');

$update_status = null;

// Handle POST updates
if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    try {
        // Handle options (t_website_options)
        if (isset($_POST['options']) && is_array($_POST['options'])) {
            // Special handling for checkboxes
            $checkbox_keys = ['enforce_single_session', 'menu_security_visible', 'menu_donations_visible', 'menu_characters_visible', 'menu_rewards_visible', 'menu_affiliate_visible', 'menu_advanced_visible', 'show_server_time', 'gp_convert_enabled'];
            foreach ($checkbox_keys as $key) {
                $val = isset($_POST['options'][$key]) ? '1' : '0';
                SetWebsiteOption($key, $val);
            }
            
            // Handle other options
            foreach ($_POST['options'] as $name => $val) {
                if (!in_array($name, $checkbox_keys)) {
                    SetWebsiteOption($name, $val);
                }
            }
        }

        // Handle settings (t_settings)
        if (isset($_POST['setting']) && is_array($_POST['setting'])) {
            foreach ($_POST['setting'] as $name => $val) {
                SetSettingValue($name, $val);
            }
        }

        // Handle Custom Logo & Background Image Uploads
        if (!empty($_FILES['site_logo_file']['name'])) {
            $logo_file = $_FILES['site_logo_file'];
            $ext = strtolower(pathinfo($logo_file['name'], PATHINFO_EXTENSION));
            if (in_array($ext, ['png', 'jpg', 'jpeg', 'gif', 'webp', 'svg'])) {
                if (!is_dir('uploads')) { @mkdir('uploads', 0777, true); }
                $dest = 'uploads/site_logo_' . time() . '.' . $ext;
                if (move_uploaded_file($logo_file['tmp_name'], $dest)) {
                    SetSettingValue('site_logo', $dest);
                }
            }
        }

        if (!empty($_FILES['site_bg_file']['name'])) {
            $bg_file = $_FILES['site_bg_file'];
            $ext = strtolower(pathinfo($bg_file['name'], PATHINFO_EXTENSION));
            if (in_array($ext, ['png', 'jpg', 'jpeg', 'webp'])) {
                if (!is_dir('uploads')) { @mkdir('uploads', 0777, true); }
                $dest = 'uploads/site_bg_' . time() . '.' . $ext;
                if (move_uploaded_file($bg_file['tmp_name'], $dest)) {
                    SetSettingValue('site_bg_image', $dest);
                }
            }
        }

        // Handle Asset Uploads (item_desc.csv, item.csv, ui_icons.zip)
        if (function_exists('ProcessItemAssetUploads')) {
            $asset_upload_results = ProcessItemAssetUploads();
        }
        
        $update_status = 'success';
    } catch (Exception $e) {
        $update_status = 'error';
        $error_msg = $e->getMessage();
    }
}

$asset_stats = function_exists('GetItemAssetStats') ? GetItemAssetStats() : ['names_count' => 0, 'icons_count' => 0, 'texture_files_count' => 0];

$tp_name  = function_exists('GetCurrencyName') ? GetCurrencyName() : (function_exists('GetWebsiteOption') ? (GetWebsiteOption('currency_name') ?: 'T-Points') : 'T-Points');
$tp_short = function_exists('GetCurrencyShort') ? GetCurrencyShort() : (function_exists('GetWebsiteOption') ? (GetWebsiteOption('currency_short') ?: 'TP') : 'TP');
