<?php $permissions->setConditions(9)->handle(GetBaseURL()); ?>
<?php
       if ( isset ( $_GET[ '_request-action' ] ) ) {
              $action = $_GET[ '_request-action' ] ;
              if ( $action === 'unhide' ) {
                     $account = isset ( $_GET [ 'account' ] ) ? $_GET [ 'account' ] : null ;
                     if ( ! AccountExists ( $account ) ) {
                            echo '<span class="inline-help">The account [<b>' , $account , '</b>] does not exists.</span>' ;
                     } elseif ( ! IsHiddenAccount ( $account ) ) {
                            echo '<span class="inline-help">The account [<b>' , $account , '</b>] was not in hidden list.</span>' ;
                     } else {
                            $db = Connection ( 'db_misc' ) ;
                            $query = $db->prepare ( 'DELETE FROM t_staff_hide WHERE account = ?' ) ;
                            if ( $query->execute ( array ( $account ) ) ) {
                                   echo '<span class="inline-info">Account was removed from hidden list successfully.</span>' ;
                            }
                     }
              } else {
                     echo '<span class="inline-help">Invalid action.</span>' ;
              }
       }
?>
<form method="POST">
       <table width="100%" cellpadding="4">
              <tr>
                     <td colspan="3" align="center" class="lcp_catlist3">
                            <font size="3"><b>Hidden Accounts</b></font>
                     </td>
              </tr>
              <?php
                     $_hidden = GetStaffHiddenAccountList ( ) ;
                     if ( count ( $_hidden ) >= 1 ) {
                            foreach ( $_hidden as $account ) {
                                   echo '<tr>' ;
                                   echo '<td width="5%" align="right">Account </td>' ;
                                   echo '<td><b><center>' , $account , '</center></b></td>' ;
                                   echo '<td><a href="' , BaseURLConcat ( 'panel/staffHidden?_request-action=unhide&account=' . $account ) , '">- Unhide</a></td>' ;
                                   echo '</tr>' ;
                            }
                     } else {
                            echo '<tr><td colspan="3" align="center">We don\'t have hidden accounts at moment. :(</td></tr>' ;
                     }
              ?>
       </table>
</form>

<form method="POST">
       <table width="100%" cellpadding="4">
              <tr>
                     <td colspan="3" align="center" class="lcp_catlist3">
                            <font size="3"><b>Add Account to Hide List</b></font>
                     </td>
              </tr>
              <tr>
                     <td width="5%">Account</td>
                     <td>
                            <input type="text" name="account" placeholder="Account Name" />
                            <input type="submit" name="hide" value="Hide Account" />
                     </td>
              </tr>
       </table>
</form>

<?php
       if ( isset ( $_SESSION[ '$.response.message' ] ) ) {
              echo $_SESSION[ '$.response.message' ] ;
              unset ( $_SESSION[ '$.response.message' ] ) ;
       }
       if ( isset ( $_POST[ "hide" ] ) ) {
              $account = $_POST[ "account" ] ;
              if ( IsEmpty ( $account ) ) {
                     echo '<span class="inline-help">Account cannot be empty.</span>' ;
              } elseif ( ! AccountExists ( $account ) ) {
                     echo '<span class="inline-help">The account [<b>' , $account , '</b>] does not exists.</span>' ;
              } else {
                     $db = Connection ( 'db_misc' ) ;
                     $query = $db->prepare ( 'INSERT INTO t_staff_hide(account) VALUES(?)' ) ;
                     if ( $query->execute ( array ( $account ) ) ) {
                            $_SESSION[ '$.response.message' ] = '<span class="inline-info">Account added to hide list successfully.</span>' ;
                            header ( sprintf ( 'Location: %s' , BaseURLConcat ( 'panel/staffHidden' ) ) ) ;
                     }
              }
       }
?>
