# ----------------------------------------------------------------------
# | Security Hardening and Performance Options                        |
# ----------------------------------------------------------------------

# 1. Protect sensitive files (Credentials, Logs, Configs, DB)
# This is placed first to ensure absolute protection
<FilesMatch "(^#.*#$)|(\.(bak|config|sql|sql\.gz|php~|php_bak|env|txt|json|log)|config\.php|Database\.php|credentials\.env|whitelist\.env)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 2. Custom Error Pages
ErrorDocument 400 /Error/400.php
ErrorDocument 401 /Error/401.php
ErrorDocument 403 /Error/403.php
ErrorDocument 404 /Error/404.php
ErrorDocument 500 /Error/500.php
ErrorDocument 503 /Error/503.php

# 3. Disable Directory Indexing
Options -Indexes

# 4. Security Headers
<IfModule mod_headers.c>
    # Anti-Clickjacking
    Header set X-Frame-Options "SAMEORIGIN"

    # Content-Type sniffing protection
    Header set X-Content-Type-Options "nosniff"

    # XSS Protection (legacy browsers)
    Header set X-XSS-Protection "1; mode=block"

    # Referrer Policy
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # Content Security Policy
    # Trusted CDNs: Cloudflare, Google Fonts, Font Awesome, PayPal, reCAPTCHA, unpkg
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://code.jquery.com https://cdnjs.cloudflare.com https://unpkg.com https://kit.fontawesome.com https://www.google.com https://www.gstatic.com https://www.googletagmanager.com https://www.paypal.com https://www.paypalobjects.com https://ajax.googleapis.com https://www.recaptcha.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com https://kit-free.fontawesome.com https://use.fontawesome.com https://unpkg.com; style-src-elem 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com https://kit-free.fontawesome.com https://use.fontawesome.com https://unpkg.com; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com https://ka-f.fontawesome.com https://kit-free.fontawesome.com https://use.fontawesome.com; img-src 'self' data: blob: https: http:; media-src 'self' blob: https:; frame-src 'self' https://www.google.com https://www.paypal.com https://www.youtube.com https://www.facebook.com https://www.recaptcha.net; connect-src 'self' blob: https://ka-f.fontawesome.com https://unpkg.com https://cdnjs.cloudflare.com https://www.google-analytics.com https://www.paypal.com https://api.paypal.com https://fcm.googleapis.com; object-src 'none'; base-uri 'self'; worker-src 'self' blob:;"
</IfModule>

# 5. PHP Security Tweaks (If allowed by host)
<IfModule mod_php.c>
    php_flag session.cookie_httponly on
    php_flag session.cookie_secure on
    php_flag display_errors off
</IfModule>
