# ====================================================================
# Talisman Online - Installer Security & Asset Protection
# ====================================================================

# 1. Prevent Directory Browsing
Options -Indexes

# 2. Block direct HTTP access to SQL dumps, environment files, and manifests
<FilesMatch "\.(sql|env|json|lock|bak|log|txt)$">
    Require all denied
</FilesMatch>

# 3. Permanent Lockout when installed.lock is present
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{DOCUMENT_ROOT}/installed.lock -f [OR]
    RewriteCond %{REQUEST_FILENAME}/../installed.lock -f [OR]
    RewriteCond %{REQUEST_FILENAME}/installed.lock -f
    RewriteRule ^.*$ - [F,L]
</IfModule>

# 4. Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "DENY"
</IfModule>
